# Development default: local Firebase Emulator only.
EXPO_PUBLIC_FIREBASE_MODE=emulator
# Windows LAN IPv4 address (required on a physical iPhone); do not use localhost on iPhone.
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=

# Existing Firebase project: medicare-ai-cf804.
# Use these values only after reviewing existing Auth users, Firestore schema and deployed Rules.
# Do not switch to staging mode until the owner confirms the review.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=medicare-ai-cf804
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
