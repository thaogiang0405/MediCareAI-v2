{
  "name": "medicare-ai-v2",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:lan": "expo start --lan",
    "start:tunnel": "expo start --tunnel",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "test": "node --test tests/*.test.mjs",
    "test:rules": "npx --yes firebase-tools emulators:exec --config firebase.emulator.json --project demo-medicare-ai --only firestore \"node --test tests/rules.integration.mjs\"",
    "test:auth": "npx --yes firebase-tools emulators:exec --config firebase.emulator.json --project demo-medicare-ai --only auth \"node --test tests/auth.integration.mjs\""
  },
  "dependencies": {
    "expo": "~58.0.0",
    "expo-router": "~58.0.0",
    "expo-status-bar": "~58.0.0",
    "firebase": "^12.0.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.0",
    "expo-constants": "~58.0.0",
    "expo-linking": "~58.0.0",
    "react-dom": "19.3.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo-clipboard": "~58.0.4",
    "expo-crypto": "~58.0.8"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.0",
    "typescript": "~6.0.0",
    "@firebase/rules-unit-testing": "^5.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  }
}
