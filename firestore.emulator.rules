rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function hasExactUserProfileFields(data) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'primaryRole',
          'roles',
          'locale',
          'timeZone',
          'onboardingCompleted',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'primaryRole',
          'roles',
          'locale',
          'timeZone',
          'onboardingCompleted',
          'createdAt',
          'updatedAt'
        ]);
    }

    function hasSingleValidRole(data) {
      return data.primaryRole is string
        && data.primaryRole in ['elderly', 'caregiver']
        && data.roles is map
        && data.roles.keys().hasAll(['elderly', 'caregiver'])
        && data.roles.keys().hasOnly(['elderly', 'caregiver'])
        && data.roles.elderly is bool
        && data.roles.caregiver is bool
        && (
          (data.primaryRole == 'elderly'
            && data.roles.elderly == true
            && data.roles.caregiver == false)
          || (data.primaryRole == 'caregiver'
            && data.roles.elderly == false
            && data.roles.caregiver == true)
        );
    }

    function hasValidUserProfileSchema(data) {
      return hasExactUserProfileFields(data)
        && data.uid is string
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 120
        && hasSingleValidRole(data)
        && data.locale == 'vi'
        && data.timeZone == 'Asia/Ho_Chi_Minh'
        && data.onboardingCompleted is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidInitialUserProfile(uid) {
      return ownsUser(uid)
        && hasValidUserProfileSchema(request.resource.data)
        && request.resource.data.uid == uid
        && request.resource.data.onboardingCompleted == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function isValidUserProfileUpdate(uid) {
      return ownsUser(uid)
        && hasValidUserProfileSchema(request.resource.data)
        && resource.data.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.uid == uid
        && request.resource.data.primaryRole == resource.data.primaryRole
        && request.resource.data.roles == resource.data.roles
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.onboardingCompleted == resource.data.onboardingCompleted
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'locale',
          'timeZone',
          'updatedAt'
        ]);
    }

    function hasValidElderlyProfile(uid) {
      return ownsUser(uid)
        && exists(/databases/$(database)/documents/users/$(uid))
        && hasValidUserProfileSchema(get(/databases/$(database)/documents/users/$(uid)).data)
        && get(/databases/$(database)/documents/users/$(uid)).data.uid == uid
        && get(/databases/$(database)/documents/users/$(uid)).data.primaryRole == 'elderly'
        && get(/databases/$(database)/documents/users/$(uid)).data.roles.elderly == true
        && get(/databases/$(database)/documents/users/$(uid)).data.roles.caregiver == false
        && get(/databases/$(database)/documents/users/$(uid)).data.onboardingCompleted == true;
    }

    function hasExactMedicationFields(data) {
      return data.keys().hasAll([
          'ownerUid',
          'name',
          'strengthText',
          'directionsText',
          'status',
          'createdAt',
          'updatedAt',
          'revision'
        ])
        && data.keys().hasOnly([
          'ownerUid',
          'name',
          'strengthText',
          'directionsText',
          'status',
          'createdAt',
          'updatedAt',
          'revision'
        ]);
    }

    function hasValidMedicationSchema(data) {
      return hasExactMedicationFields(data)
        && data.ownerUid is string
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 120
        && data.name.matches('.*\\S.*')
        && data.strengthText is string
        && data.strengthText.size() <= 80
        && data.directionsText is string
        && data.directionsText.size() <= 500
        && data.status is string
        && data.status in ['active', 'inactive']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.revision is int
        && data.revision >= 1;
    }

    function isValidMedicationCreate(uid) {
      return hasValidElderlyProfile(uid)
        && hasValidMedicationSchema(request.resource.data)
        && request.resource.data.ownerUid == uid
        && request.resource.data.status == 'active'
        && request.resource.data.revision == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function isValidMedicationUpdate(uid) {
      return hasValidElderlyProfile(uid)
        && hasValidMedicationSchema(resource.data)
        && hasValidMedicationSchema(request.resource.data)
        && resource.data.ownerUid == uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.ownerUid == uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'strengthText',
          'directionsText',
          'status',
          'updatedAt',
          'revision'
        ])
        && (
          (resource.data.status == 'active'
            && request.resource.data.status in ['active', 'inactive'])
          || (resource.data.status == 'inactive'
            && request.resource.data.status == 'inactive')
        );
    }

    function hasExactMedicationScheduleFields(data) {
      return data.keys().hasAll([
          'ownerUid',
          'medicationId',
          'recurrence',
          'localTime',
          'weekdays',
          'startDate',
          'endDate',
          'timeZone',
          'active',
          'revision',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid',
          'medicationId',
          'recurrence',
          'localTime',
          'weekdays',
          'startDate',
          'endDate',
          'timeZone',
          'active',
          'revision',
          'createdAt',
          'updatedAt'
        ]);
    }

    function hasValidMedicationScheduleDate(value) {
      // ISO calendar date in the reviewed M3.3 range, including leap days.
      return value is string
        && (
          value.matches('^20[0-9]{2}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))$')
          || value.matches('^20(?:00|0[48]|[2468][048]|[13579][26])-02-29$')
        );
    }

    function hasValidMedicationScheduleWeekdays(recurrence, weekdays) {
      return weekdays is list
        && hasValidMedicationScheduleWeekdaySet(recurrence, weekdays.toSet(), weekdays.size());
    }

    function hasValidMedicationScheduleWeekdaySet(recurrence, weekdaySet, weekdayCount) {
      return weekdayCount >= 1
        && weekdayCount <= 7
        && weekdaySet.size() == weekdayCount
        && weekdaySet.hasOnly([1, 2, 3, 4, 5, 6, 7])
        && (
          (recurrence == 'daily'
            && weekdayCount == 7
            && weekdaySet.hasAll([1, 2, 3, 4, 5, 6, 7]))
          || (recurrence == 'weekly' && weekdayCount >= 1)
        );
    }

    function hasValidMedicationScheduleSchema(data) {
      return hasExactMedicationScheduleFields(data)
        && data.ownerUid is string
        && data.medicationId is string
        && data.medicationId.size() >= 1
        && data.medicationId.size() <= 150
        && data.medicationId.matches('^[^/]+$')
        && data.recurrence is string
        && data.recurrence in ['daily', 'weekly']
        && data.localTime is string
        && data.localTime.matches('^(?:[01][0-9]|2[0-3]):[0-5][0-9]$')
        && hasValidMedicationScheduleWeekdays(data.recurrence, data.weekdays)
        && hasValidMedicationScheduleDate(data.startDate)
        && (
          data.endDate == null
          || (hasValidMedicationScheduleDate(data.endDate) && data.endDate >= data.startDate)
        )
        && data.timeZone == 'Asia/Ho_Chi_Minh'
        && data.active is bool
        && data.revision is int
        && data.revision >= 1
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function hasActiveOwnedMedication(uid, medicationId) {
      return medicationId is string
        && exists(/databases/$(database)/documents/elderlyProfiles/$(uid)/medications/$(medicationId))
        && isActiveOwnedMedicationData(
          uid,
          get(/databases/$(database)/documents/elderlyProfiles/$(uid)/medications/$(medicationId)).data
        );
    }

    function isActiveOwnedMedicationData(uid, data) {
      return hasValidMedicationSchema(data)
        && data.ownerUid == uid
        && data.status == 'active';
    }

    function isValidMedicationScheduleCreate(uid) {
      return hasValidElderlyProfile(uid)
        && hasValidMedicationScheduleSchema(request.resource.data)
        && request.resource.data.ownerUid == uid
        && request.resource.data.active == true
        && request.resource.data.revision == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && hasActiveOwnedMedication(uid, request.resource.data.medicationId);
    }

    function isValidMedicationScheduleUpdate(uid) {
      return hasValidElderlyProfile(uid)
        && hasValidMedicationScheduleSchema(request.resource.data)
        && resource.data.ownerUid == uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.ownerUid == uid
        && request.resource.data.medicationId == resource.data.medicationId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'recurrence',
          'localTime',
          'weekdays',
          'startDate',
          'endDate',
          'active',
          'updatedAt',
          'revision'
        ])
        && (
          (resource.data.active == false && request.resource.data.active == false)
          || (
            resource.data.active == true
            && (
              request.resource.data.active == false
              || hasActiveOwnedMedication(uid, resource.data.medicationId)
            )
          )
        );
    }

    function hasExactDoseEventFields(data) {
      return data.keys().hasAll([
          'ownerUid',
          'scheduleId',
          'medicationId',
          'occurrenceKey',
          'scheduledAt',
          'scheduledLocalDate',
          'scheduledLocalTime',
          'timeZone',
          'medicationSnapshot',
          'status',
          'responseSource',
          'respondedAt',
          'respondedBy',
          'responseHistory',
          'revision',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid',
          'scheduleId',
          'medicationId',
          'occurrenceKey',
          'scheduledAt',
          'scheduledLocalDate',
          'scheduledLocalTime',
          'timeZone',
          'medicationSnapshot',
          'status',
          'responseSource',
          'respondedAt',
          'respondedBy',
          'responseHistory',
          'revision',
          'createdAt',
          'updatedAt'
        ]);
    }

    function hasValidDoseEventMedicationSnapshot(snapshot) {
      return snapshot is map
        && snapshot.keys().hasAll(['name', 'strengthText', 'directionsText'])
        && snapshot.keys().hasOnly(['name', 'strengthText', 'directionsText'])
        && snapshot.name is string
        && snapshot.name.size() >= 1
        && snapshot.name.size() <= 120
        && snapshot.name.matches('.*\\S.*')
        && snapshot.strengthText is string
        && snapshot.strengthText.size() <= 80
        && snapshot.directionsText is string
        && snapshot.directionsText.size() <= 500;
    }

    function hasValidDoseEventResponseHistory(history, uid, status) {
      return history is map
        && history.keys().hasAll(['initial'])
        && history.keys().hasOnly(['initial'])
        && history.initial is map
        && history.initial.keys().hasAll(['status', 'responseSource', 'respondedAt', 'respondedBy'])
        && history.initial.keys().hasOnly(['status', 'responseSource', 'respondedAt', 'respondedBy'])
        && history.initial.status == status
        && history.initial.responseSource == 'selfReported'
        && history.initial.respondedAt == request.time
        && history.initial.respondedBy == uid;
    }

    // Firestore stores timestamps in UTC. Viet Nam does not observe daylight
    // saving time, so adding seven hours lets Rules validate the exact HCM
    // calendar day and wall-clock time supplied by the client.
    function hasExactHcmDoseEventTimestamp(data) {
      let dateParts = data.scheduledLocalDate.split('-');
      let timeParts = data.scheduledLocalTime.split(':');
      let hcmScheduledAt = data.scheduledAt + duration.time(7, 0, 0, 0);
      let expectedHcmScheduledAt = timestamp.date(
        int(dateParts[0]),
        int(dateParts[1]),
        int(dateParts[2])
      ) + duration.time(int(timeParts[0]), int(timeParts[1]), 0, 0);
      return hcmScheduledAt == expectedHcmScheduledAt;
    }

    function hasValidDoseEventSchema(data, uid) {
      return hasExactDoseEventFields(data)
        && data.ownerUid is string
        && data.scheduleId is string
        && data.scheduleId.size() >= 1
        && data.scheduleId.size() <= 150
        && data.scheduleId.matches('^[^/]+$')
        && data.medicationId is string
        && data.medicationId.size() >= 1
        && data.medicationId.size() <= 150
        && data.medicationId.matches('^[^/]+$')
        && data.occurrenceKey is string
        && data.scheduledLocalDate is string
        && hasValidMedicationScheduleDate(data.scheduledLocalDate)
        && data.scheduledLocalTime is string
        && data.scheduledLocalTime.matches('^(?:[01][0-9]|2[0-3]):[0-5][0-9]$')
        && data.occurrenceKey == data.scheduledLocalDate + 'T' + data.scheduledLocalTime + '@Asia/Ho_Chi_Minh'
        && data.scheduledAt is timestamp
        && data.scheduledAt <= request.time
        && hasExactHcmDoseEventTimestamp(data)
        && data.timeZone == 'Asia/Ho_Chi_Minh'
        && hasValidDoseEventMedicationSnapshot(data.medicationSnapshot)
        && data.status is string
        && data.status in ['reportedTaken', 'reportedSkipped']
        && data.responseSource == 'selfReported'
        && data.respondedAt == request.time
        && data.respondedBy == uid
        && hasValidDoseEventResponseHistory(data.responseHistory, uid, data.status)
        && data.revision == 1
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function hasValidDoseEventScheduleReference(uid, data) {
      let schedulePath = /databases/$(database)/documents/elderlyProfiles/$(uid)/medicationSchedules/$(data.scheduleId);
      let schedule = get(schedulePath).data;
      let hcmScheduledAt = data.scheduledAt + duration.time(7, 0, 0, 0);
      return exists(schedulePath)
        && schedule.ownerUid == uid
        && schedule.active == true
        && schedule.medicationId == data.medicationId
        && schedule.localTime == data.scheduledLocalTime
        && schedule.timeZone == data.timeZone
        && schedule.recurrence is string
        && schedule.recurrence in ['daily', 'weekly']
        && schedule.weekdays is list
        && (
          schedule.recurrence == 'daily'
          || (
            schedule.recurrence == 'weekly'
            && schedule.weekdays.toSet().hasAll([hcmScheduledAt.dayOfWeek()])
          )
        )
        && schedule.startDate is string
        && data.scheduledLocalDate >= schedule.startDate
        && (
          schedule.endDate == null
          || (schedule.endDate is string && data.scheduledLocalDate <= schedule.endDate)
        );
    }

    function hasValidDoseEventMedicationReference(uid, data) {
      let medicationPath = /databases/$(database)/documents/elderlyProfiles/$(uid)/medications/$(data.medicationId);
      let medication = get(medicationPath).data;
      return exists(medicationPath)
        // M3.2 Rules enforce the exact persisted schema; only an active
        // same-owner medication can anchor a new self-report.
        && medication.ownerUid == uid
        && medication.status == 'active'
        && medication.name == data.medicationSnapshot.name
        && medication.strengthText == data.medicationSnapshot.strengthText
        && medication.directionsText == data.medicationSnapshot.directionsText;
    }

    function isValidDoseEventCreate(uid, doseEventId) {
      return hasValidElderlyProfile(uid)
        && hasValidDoseEventSchema(request.resource.data, uid)
        && request.resource.data.ownerUid == uid
        && doseEventId == request.resource.data.scheduleId
          + '__' + request.resource.data.scheduledLocalDate
          + '__' + request.resource.data.scheduledLocalTime
        && hasValidDoseEventScheduleReference(uid, request.resource.data)
        && hasValidDoseEventMedicationReference(uid, request.resource.data);
    }


    function isFamily(uid) {
      let p = /databases/$(database)/documents/users/$(uid);
      return exists(p) && get(p).data.uid == uid
        && get(p).data.primaryRole == 'caregiver'
        && get(p).data.roles.caregiver == true
        && get(p).data.roles.elderly == false
        && get(p).data.onboardingCompleted == true;
    }
    function isSenior(uid) {
      let p = /databases/$(database)/documents/users/$(uid);
      return exists(p) && get(p).data.uid == uid
        && get(p).data.primaryRole == 'elderly'
        && get(p).data.roles.elderly == true
        && get(p).data.roles.caregiver == false
        && get(p).data.onboardingCompleted == true;
    }
    function memberAvailable(uid) {
      let p = /databases/$(database)/documents/connectionMembers/$(uid);
      return !exists(p) || get(p).data.status == 'disconnected';
    }
    function validCode(code) {
      return code.matches('^[A-HJ-NP-Z2-9]{8}$');
    }
    function validInvite(data, code) {
      return data.keys().hasOnly(['familyUid','familyDisplayName','status','createdAt','expiresAt','usedBy','usedAt','connectionId','updatedAt'])
        && data.familyUid is string && data.familyDisplayName is string
        && data.status in ['active','used','revoked'] && validCode(code)
        && data.createdAt is timestamp && data.expiresAt is timestamp
        && (data.usedBy == null || data.usedBy is string)
        && (data.usedAt == null || data.usedAt is timestamp)
        && (data.connectionId == null || data.connectionId is string)
        && data.updatedAt is timestamp;
    }
    function validSlot(data) {
      return data.keys().hasOnly(['familyUid','inviteCode','status','createdAt','expiresAt','usedBy','usedAt','connectionId','updatedAt'])
        && data.familyUid is string && validCode(data.inviteCode)
        && data.status in ['active','used'] && data.createdAt is timestamp
        && data.expiresAt is timestamp && data.updatedAt is timestamp
        && (data.usedBy == null || data.usedBy is string)
        && (data.usedAt == null || data.usedAt is timestamp)
        && (data.connectionId == null || data.connectionId is string);
    }
    function validConnection(data, code) {
      return data.keys().hasOnly(['familyUid','seniorUid','familyDisplayName','seniorDisplayName','status','createdAt','connectedAt','disconnectedAt','disconnectedBy','updatedAt'])
        && data.familyUid is string && data.seniorUid is string
        && data.familyUid != data.seniorUid && validCode(code)
        && data.familyDisplayName is string && data.seniorDisplayName is string
        && data.status in ['connected','disconnected']
        && data.createdAt is timestamp && data.connectedAt is timestamp
        && (data.disconnectedAt == null || data.disconnectedAt is timestamp)
        && (data.disconnectedBy == null || data.disconnectedBy is string)
        && data.updatedAt is timestamp;
    }
    function validMember(data, uid) {
      return data.keys().hasOnly(['uid','role','counterpartUid','counterpartDisplayName','connectionId','status','createdAt','updatedAt'])
        && data.uid == uid && data.role in ['family','senior']
        && data.counterpartUid is string && data.counterpartUid != uid
        && data.counterpartDisplayName is string && validCode(data.connectionId)
        && data.status in ['connected','disconnected']
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    function connectionParticipant(data) {
      return signedIn() && (request.auth.uid == data.familyUid || request.auth.uid == data.seniorUid);
    }
    function createInvite(code) {
      let d = request.resource.data;
      let slot = /databases/$(database)/documents/connectionInviteSlots/$(request.auth.uid);
      return signedIn() && isFamily(request.auth.uid) && validInvite(d, code)
        && d.familyUid == request.auth.uid && d.familyDisplayName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
        && d.status == 'active' && d.createdAt == request.time && d.updatedAt == request.time
        && d.expiresAt > request.time && d.expiresAt <= request.time + duration.value(15,'m')
        && d.usedBy == null && d.usedAt == null && d.connectionId == null
        && memberAvailable(request.auth.uid) && existsAfter(slot)
        && getAfter(slot).data.inviteCode == code && getAfter(slot).data.status == 'active'
        && getAfter(slot).data.expiresAt == d.expiresAt;
    }
    function createSlot(uid) {
      let d = request.resource.data;
      let invite = /databases/$(database)/documents/connectionInvites/$(d.inviteCode);
      return signedIn() && isFamily(request.auth.uid) && uid == request.auth.uid
        && validSlot(d) && d.familyUid == uid && d.status == 'active'
        && d.createdAt == request.time && d.updatedAt == request.time
        && d.expiresAt > request.time && d.expiresAt <= request.time + duration.value(15,'m')
        && d.usedBy == null && d.usedAt == null && d.connectionId == null
        && memberAvailable(uid) && existsAfter(invite)
        && getAfter(invite).data.familyUid == uid && getAfter(invite).data.status == 'active'
        && getAfter(invite).data.expiresAt == d.expiresAt;
    }
    function updateSlotFamily(uid) {
      let d = request.resource.data;
      let newInvite = /databases/$(database)/documents/connectionInvites/$(d.inviteCode);
      let oldInvite = /databases/$(database)/documents/connectionInvites/$(resource.data.inviteCode);
      return signedIn() && isFamily(request.auth.uid) && uid == request.auth.uid
        && resource.data.familyUid == uid && validSlot(d) && d.familyUid == uid
        && d.inviteCode != resource.data.inviteCode && d.status == 'active'
        && d.createdAt == request.time && d.updatedAt == request.time
        && d.expiresAt > request.time && d.expiresAt <= request.time + duration.value(15,'m')
        && d.usedBy == null && d.usedAt == null && d.connectionId == null
        && memberAvailable(uid)
        && (resource.data.status != 'active' || (existsAfter(oldInvite) && getAfter(oldInvite).data.status == 'revoked'))
        && existsAfter(newInvite) && getAfter(newInvite).data.status == 'active'
        && getAfter(newInvite).data.familyUid == uid && getAfter(newInvite).data.expiresAt == d.expiresAt;
    }
    function useInvite(code) {
      let slot = /databases/$(database)/documents/connectionInviteSlots/$(resource.data.familyUid);
      let conn = /databases/$(database)/documents/connections/$(code);
      return signedIn() && isSenior(request.auth.uid) && resource.data.status == 'active'
        && resource.data.expiresAt > request.time && request.resource.data.status == 'used'
        && request.resource.data.usedBy == request.auth.uid && request.resource.data.usedAt == request.time
        && request.resource.data.connectionId == code && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','usedBy','usedAt','connectionId','updatedAt'])
        && exists(slot) && get(slot).data.inviteCode == code && get(slot).data.status == 'active'
        && get(slot).data.expiresAt > request.time && existsAfter(slot)
        && getAfter(slot).data.status == 'used' && getAfter(slot).data.usedBy == request.auth.uid
        && existsAfter(conn) && getAfter(conn).data.status == 'connected'
        && getAfter(conn).data.seniorUid == request.auth.uid;
    }
    function useSlot(uid) {
      let invite = /databases/$(database)/documents/connectionInvites/$(resource.data.inviteCode);
      let conn = /databases/$(database)/documents/connections/$(resource.data.inviteCode);
      return signedIn() && isSenior(request.auth.uid) && resource.data.familyUid == uid
        && resource.data.status == 'active' && request.resource.data.familyUid == uid
        && request.resource.data.inviteCode == resource.data.inviteCode
        && request.resource.data.status == 'used' && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.usedAt == request.time && request.resource.data.connectionId == resource.data.inviteCode
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','usedBy','usedAt','connectionId','updatedAt'])
        && existsAfter(invite) && getAfter(invite).data.status == 'used'
        && existsAfter(conn) && getAfter(conn).data.status == 'connected'
        && getAfter(conn).data.familyUid == uid && getAfter(conn).data.seniorUid == request.auth.uid;
    }
    function createConnection(code) {
      let d = request.resource.data;
      let invite = /databases/$(database)/documents/connectionInvites/$(code);
      let slot = /databases/$(database)/documents/connectionInviteSlots/$(d.familyUid);
      let fm = /databases/$(database)/documents/connectionMembers/$(d.familyUid);
      let sm = /databases/$(database)/documents/connectionMembers/$(d.seniorUid);
      return signedIn() && isSenior(request.auth.uid) && validConnection(d,code)
        && d.seniorUid == request.auth.uid && isFamily(d.familyUid)
        && d.familyDisplayName == get(/databases/$(database)/documents/users/$(d.familyUid)).data.displayName
        && d.seniorDisplayName == get(/databases/$(database)/documents/users/$(d.seniorUid)).data.displayName
        && d.status == 'connected' && d.createdAt == request.time && d.connectedAt == request.time
        && d.updatedAt == request.time && d.disconnectedAt == null && d.disconnectedBy == null
        && memberAvailable(d.familyUid) && memberAvailable(d.seniorUid)
        && exists(invite) && get(invite).data.familyUid == d.familyUid
        && get(invite).data.status == 'active' && get(invite).data.expiresAt > request.time
        && exists(slot) && get(slot).data.inviteCode == code && get(slot).data.status == 'active'
        && existsAfter(invite) && getAfter(invite).data.status == 'used'
        && getAfter(invite).data.usedBy == request.auth.uid
        && existsAfter(slot) && getAfter(slot).data.status == 'used'
        && getAfter(slot).data.usedBy == request.auth.uid
        && existsAfter(fm) && getAfter(fm).data.connectionId == code
        && getAfter(fm).data.status == 'connected'
        && existsAfter(sm) && getAfter(sm).data.connectionId == code
        && getAfter(sm).data.status == 'connected';
    }
    function createMember(uid,d) {
      let conn = /databases/$(database)/documents/connections/$(d.connectionId);
      let famUid = d.role == 'family' ? uid : d.counterpartUid;
      let invite = /databases/$(database)/documents/connectionInvites/$(d.connectionId);
      let slot = /databases/$(database)/documents/connectionInviteSlots/$(famUid);
      return signedIn() && isSenior(request.auth.uid) && validMember(d,uid)
        && d.status == 'connected' && d.createdAt == request.time && d.updatedAt == request.time
        && memberAvailable(uid) && existsAfter(conn) && getAfter(conn).data.status == 'connected'
        && getAfter(conn).data.seniorUid == request.auth.uid
        && (
          (uid == getAfter(conn).data.familyUid
            && d.role == 'family'
            && d.counterpartUid == getAfter(conn).data.seniorUid
            && d.counterpartDisplayName == getAfter(conn).data.seniorDisplayName)
          || (uid == getAfter(conn).data.seniorUid
            && d.role == 'senior'
            && d.counterpartUid == getAfter(conn).data.familyUid
            && d.counterpartDisplayName == getAfter(conn).data.familyDisplayName)
        )
        && existsAfter(invite) && getAfter(invite).data.status == 'used'
        && getAfter(invite).data.usedBy == request.auth.uid
        && existsAfter(slot) && getAfter(slot).data.status == 'used'
        && getAfter(slot).data.inviteCode == d.connectionId;
    }
    function disconnectConnection(code) {
      let fm = /databases/$(database)/documents/connectionMembers/$(resource.data.familyUid);
      let sm = /databases/$(database)/documents/connectionMembers/$(resource.data.seniorUid);
      return connectionParticipant(resource.data) && resource.data.status == 'connected'
        && request.resource.data.status == 'disconnected'
        && request.resource.data.disconnectedAt == request.time
        && request.resource.data.disconnectedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','disconnectedAt','disconnectedBy','updatedAt'])
        && existsAfter(fm) && getAfter(fm).data.status == 'disconnected'
        && getAfter(fm).data.connectionId == code
        && existsAfter(sm) && getAfter(sm).data.status == 'disconnected'
        && getAfter(sm).data.connectionId == code;
    }
    function disconnectMember(uid) {
      let conn = /databases/$(database)/documents/connections/$(resource.data.connectionId);
      return signedIn() && resource.data.status == 'connected'
        && request.resource.data.status == 'disconnected'
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
        && existsAfter(conn) && getAfter(conn).data.status == 'disconnected'
        && getAfter(conn).data.disconnectedBy == request.auth.uid
        && ((uid == getAfter(conn).data.familyUid && resource.data.role == 'family' && resource.data.counterpartUid == getAfter(conn).data.seniorUid)
          || (uid == getAfter(conn).data.seniorUid && resource.data.role == 'senior' && resource.data.counterpartUid == getAfter(conn).data.familyUid));
    }

    // Migration 2.3 profile surface. `get` deliberately
    // excludes collection queries so users cannot enumerate other profiles.
    match /users/{uid} {
      allow get: if ownsUser(uid);
      allow list: if false;
      allow create: if isValidInitialUserProfile(uid);
      allow update: if isValidUserProfileUpdate(uid);
      allow delete: if false;

      // Device, notification, and index schemas are not part of M2.3 yet.
      match /{document=**} {
        allow read, write: if false;
      }
    }

    // A role selected by the client is not a health-data authorization grant.
    // These surfaces remain closed until their schema, server workflow, and
    // emulator coverage are approved in a later milestone.
    match /caregiverProfiles/{document=**} {
      allow read, write: if false;
    }

    match /caregiverInvites/{document=**} {
      allow read, write: if false;
    }


    match /connectionInvites/{code} {
      allow get: if signedIn() && ((resource.data.familyUid == request.auth.uid && isFamily(request.auth.uid))
        || (isSenior(request.auth.uid) && resource.data.status == 'active'
          && exists(/databases/$(database)/documents/connectionInviteSlots/$(resource.data.familyUid))
          && get(/databases/$(database)/documents/connectionInviteSlots/$(resource.data.familyUid)).data.inviteCode == code));
      allow list: if false;
      allow create: if createInvite(code);
      allow update: if (signedIn() && isFamily(request.auth.uid)
          && resource.data.familyUid == request.auth.uid && resource.data.status == 'active'
          && request.resource.data.status == 'revoked' && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']))
        || useInvite(code);
      allow delete: if false;
    }
    match /connectionInviteSlots/{uid} {
      allow get: if signedIn() && request.auth.uid == uid && isFamily(uid);
      allow list: if false;
      allow create: if createSlot(uid);
      allow update: if updateSlotFamily(uid) || useSlot(uid);
      allow delete: if false;
    }
    match /connections/{code} {
      allow get: if connectionParticipant(resource.data);
      allow list: if false;
      allow create: if createConnection(code);
      allow update: if disconnectConnection(code);
      allow delete: if false;
    }
    match /connectionMembers/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create: if createMember(uid,request.resource.data);
      allow update: if createMember(uid,request.resource.data) || disconnectMember(uid);
      allow delete: if false;
    }

    // M3.2: an elderly owner may access only their own medication records.
    // A profile role from the UI never grants access; the canonical M2.3
    // `/users/{uid}` document is checked for every operation.
    match /elderlyProfiles/{uid}/medications/{medicationId} {
      allow get, list: if hasValidElderlyProfile(uid);
      allow create: if isValidMedicationCreate(uid);
      allow update: if isValidMedicationUpdate(uid);
      allow delete: if false;
    }

    // M3.3: schedules use the same elderly-owner boundary as medications.
    // They never grant notification, DoseEvent, or caregiver access.
    match /elderlyProfiles/{uid}/medicationSchedules/{scheduleId} {
      allow get, list: if hasValidElderlyProfile(uid);
      allow create: if isValidMedicationScheduleCreate(uid);
      allow update: if isValidMedicationScheduleUpdate(uid);
      allow delete: if false;
    }

    // M3.4: an elderly owner may create and read exactly one immutable
    // self-reported response for a real planned occurrence. Client updates,
    // deletes, notification documents, and caregiver access remain denied.
    match /elderlyProfiles/{uid}/doseEvents/{doseEventId} {
      allow get, list: if hasValidElderlyProfile(uid);
      allow create: if isValidDoseEventCreate(uid, doseEventId);
      allow update, delete: if false;
    }

    match /elderlyProfiles/{document=**} {
      allow read, write: if false;
    }

    // Explicit default-deny for every future collection and subcollection.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}