rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function hasExactUserProfileFields(data) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'primaryRole',
          'roles',
          'locale',
          'timeZone',
          'onboardingCompleted',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'primaryRole',
          'roles',
          'locale',
          'timeZone',
          'onboardingCompleted',
          'createdAt',
          'updatedAt'
        ]);
    }

    function hasSingleValidRole(data) {
      return data.primaryRole is string
        && data.primaryRole in ['elderly', 'caregiver']
        && data.roles is map
        && data.roles.keys().hasAll(['elderly', 'caregiver'])
        && data.roles.keys().hasOnly(['elderly', 'caregiver'])
        && data.roles.elderly is bool
        && data.roles.caregiver is bool
        && (
          (data.primaryRole == 'elderly'
            && data.roles.elderly == true
            && data.roles.caregiver == false)
          || (data.primaryRole == 'caregiver'
            && data.roles.elderly == false
            && data.roles.caregiver == true)
        );
    }

    function hasValidUserProfileSchema(data) {
      return hasExactUserProfileFields(data)
        && data.uid is string
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 120
        && hasSingleValidRole(data)
        && data.locale == 'vi'
        && data.timeZone == 'Asia/Ho_Chi_Minh'
        && data.onboardingCompleted is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidInitialUserProfile(uid) {
      return ownsUser(uid)
        && hasValidUserProfileSchema(request.resource.data)
        && request.resource.data.uid == uid
        && request.resource.data.onboardingCompleted == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function isValidUserProfileUpdate(uid) {
      return ownsUser(uid)
        && hasValidUserProfileSchema(request.resource.data)
        && resource.data.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.uid == uid
        && request.resource.data.primaryRole == resource.data.primaryRole
        && request.resource.data.roles == resource.data.roles
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.onboardingCompleted == resource.data.onboardingCompleted
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'locale',
          'timeZone',
          'updatedAt'
        ]);
    }

    function hasValidElderlyProfileData(uid) {
      let profile = get(/databases/$(database)/documents/users/$(uid)).data;
      return hasValidUserProfileSchema(profile)
        && profile.uid == uid
        && profile.primaryRole == 'elderly'
        && profile.roles.elderly == true
        && profile.roles.caregiver == false
        && profile.onboardingCompleted == true;
    }

    function hasValidElderlyProfile(uid) {
      return ownsUser(uid)
        && exists(/databases/$(database)/documents/users/$(uid))
        && hasValidElderlyProfileData(uid);
    }

    function hasExactMedicationFields(data) {
      return data.keys().hasAll([
          'ownerUid', 'name', 'strengthText', 'directionsText',
          'status', 'createdAt', 'updatedAt', 'revision'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'name', 'strengthText', 'dosage', 'dosageUnit',
          'dosageForm', 'frequency', 'intakeTimes', 'directionsText',
          'startDate', 'endDate', 'notes', 'status', 'createdByUid',
          'updatedByUid', 'createdAt', 'updatedAt', 'deletedAt', 'revision'
        ]);
    }

    function hasValidMedicationTime(value) {
      return value is string
        && value.size() == 5
        && value.matches('^(?:[01][0-9]|2[0-3]):[0-5][0-9]');
    }

    function hasValidMedicationIntakeTimes(times) {
      return times is list
        && times.size() >= 1
        && times.size() <= 6
        && times.toSet().size() == times.size()
        && (times.size() < 1 || hasValidMedicationTime(times[0]))
        && (times.size() < 2 || hasValidMedicationTime(times[1]))
        && (times.size() < 3 || hasValidMedicationTime(times[2]))
        && (times.size() < 4 || hasValidMedicationTime(times[3]))
        && (times.size() < 5 || hasValidMedicationTime(times[4]))
        && (times.size() < 6 || hasValidMedicationTime(times[5]));
    }

    function hasValidMedicationDate(value) {
      return value is string
        && value.size() == 10
        && value.matches('^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])');
    }

    function hasValidMedicationSchema(data) {
      return hasExactMedicationFields(data)
        && data.ownerUid is string
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.name.matches('.*[^ ].*')
        && data.strengthText is string && data.strengthText.size() <= 80
        && data.directionsText is string && data.directionsText.size() <= 500
        && data.status is string && data.status in ['active', 'inactive', 'deleted']
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && data.revision is int && data.revision >= 1
        && (!('dosage' in data) || (data.dosage is string && data.dosage.size() <= 40))
        && (!('dosageUnit' in data) || (data.dosageUnit is string && data.dosageUnit.size() <= 40))
        && (!('dosageForm' in data) || data.dosageForm in ['tablet', 'capsule', 'syrup', 'solution', 'powder', 'other'])
        && (!('frequency' in data) || (data.frequency is int && data.frequency >= 1 && data.frequency <= 6))
        && (!('intakeTimes' in data) || hasValidMedicationIntakeTimes(data.intakeTimes))
        && (!('startDate' in data) || data.startDate == null || data.startDate == '' || (data.startDate is string && hasValidMedicationDate(data.startDate)))
        && (!('endDate' in data) || data.endDate == null || data.endDate == '' || (data.endDate is string && hasValidMedicationDate(data.endDate)))
        && (!('startDate' in data) || !('endDate' in data) || data.startDate == null || data.startDate == '' || data.endDate == null || data.endDate == '' || data.endDate >= data.startDate)
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && (!('createdByUid' in data) || data.createdByUid is string)
        && (!('updatedByUid' in data) || data.updatedByUid is string)
        && (!('deletedAt' in data) || data.deletedAt == null || data.deletedAt is timestamp);
    }

    function hasActiveMedicationConnectionRecordData(uid, pair, connectionPath) {
      let connection = get(connectionPath).data;
      return connection.status == 'connected'
        && connection.familyUid == request.auth.uid
        && connection.seniorUid == uid;
    }

    function hasActiveMedicationConnectionRecord(uid, pair) {
      let connectionPath = /databases/$(database)/documents/connections/$(pair.connectionId);
      return exists(connectionPath)
        && hasActiveMedicationConnectionRecordData(uid, pair, connectionPath);
    }

    function hasActiveMedicationConnectionData(uid, pairPath) {
      let pair = get(pairPath).data;
      return pair.status == 'connected'
        && hasActiveMedicationConnectionRecord(uid, pair);
    }

    function hasActiveMedicationConnectionForSignedInUser(uid) {
      let pairPath = /databases/$(database)/documents/connectionPairs/$(request.auth.uid)/seniors/$(uid);
      let caregiverPath = /databases/$(database)/documents/users/$(request.auth.uid);
      let caregiver = get(caregiverPath).data;
      return exists(caregiverPath)
        && caregiver.uid == request.auth.uid
        && hasValidUserProfileSchema(caregiver)
        && caregiver.primaryRole == 'caregiver'
        && caregiver.onboardingCompleted == true
        && exists(pairPath)
        && hasActiveMedicationConnectionData(uid, pairPath);
    }

    function hasActiveMedicationConnection(uid) {
      return signedIn() && hasActiveMedicationConnectionForSignedInUser(uid);
    }

    function canAccessMedicationProfile(uid) {
      return hasValidElderlyProfile(uid) || hasActiveMedicationConnection(uid);
    }

    function hasPhase04MedicationFields(data) {
      return data.keys().hasAll([
        'dosage', 'dosageUnit', 'dosageForm', 'frequency', 'intakeTimes',
        'startDate', 'endDate', 'notes', 'createdByUid', 'updatedByUid', 'deletedAt'
      ]);
    }

    function isValidMedicationCreate(uid) {
      return canAccessMedicationProfile(uid)
        && hasValidMedicationSchema(request.resource.data)
        && hasPhase04MedicationFields(request.resource.data)
        && request.resource.data.ownerUid == uid
        && request.resource.data.name.size() >= 1
        && request.resource.data.dosage.size() >= 1
        && request.resource.data.dosageUnit.size() >= 1
        && request.resource.data.frequency == request.resource.data.intakeTimes.size()
        && request.resource.data.status == 'active'
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.deletedAt == null
        && request.resource.data.revision == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function isValidMedicationUpdate(uid) {
      // The existing document was accepted by the previous create/update Rules.
      // Validate the changed document once; revalidating the full old and new
      // maps in the same request can exceed Firestore's Rules expression budget.
      return canAccessMedicationProfile(uid)
        && resource.data.ownerUid == uid
        && resource.data.revision is int
        && resource.data.revision >= 1
        && resource.data.status in ['active', 'inactive']
        && resource.data.createdAt is timestamp
        && hasValidMedicationSchema(request.resource.data)
        && hasPhase04MedicationFields(request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdByUid == resource.data.get('createdByUid', uid)
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.frequency == request.resource.data.intakeTimes.size()
        && resource.data.status != 'deleted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'strengthText', 'dosage', 'dosageUnit', 'dosageForm',
          'frequency', 'intakeTimes', 'directionsText', 'startDate',
          'endDate', 'notes', 'status', 'createdByUid', 'updatedByUid',
          'updatedAt', 'deletedAt', 'revision'
        ])
        && (
          (request.resource.data.status in ['active', 'inactive']
            && request.resource.data.deletedAt == null)
          || (request.resource.data.status == 'deleted'
            && request.resource.data.deletedAt == request.time)
        );
    }

    function hasExactMedicationScheduleFields(data) {
      return data.keys().hasAll([
          'ownerUid',
          'medicationId',
          'recurrence',
          'localTime',
          'weekdays',
          'startDate',
          'endDate',
          'timeZone',
          'active',
          'revision',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid',
          'medicationId',
          'recurrence',
          'localTime',
          'weekdays',
          'startDate',
          'endDate',
          'timeZone',
          'active',
          'revision',
          'createdAt',
          'updatedAt'
        ]);
    }

    function hasValidMedicationScheduleDate(value) {
      // ISO calendar date in the reviewed M3.3 range, including leap days.
      return value is string
        && (
          value.matches('^20[0-9]{2}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))$')
          || value.matches('^20(?:00|0[48]|[2468][048]|[13579][26])-02-29$')
        );
    }

    function hasValidMedicationScheduleWeekdays(recurrence, weekdays) {
      return weekdays is list
        && hasValidMedicationScheduleWeekdaySet(recurrence, weekdays.toSet(), weekdays.size());
    }

    function hasValidMedicationScheduleWeekdaySet(recurrence, weekdaySet, weekdayCount) {
      return weekdayCount >= 1
        && weekdayCount <= 7
        && weekdaySet.size() == weekdayCount
        && weekdaySet.hasOnly([1, 2, 3, 4, 5, 6, 7])
        && (
          (recurrence == 'daily'
            && weekdayCount == 7
            && weekdaySet.hasAll([1, 2, 3, 4, 5, 6, 7]))
          || (recurrence == 'weekly' && weekdayCount >= 1)
        );
    }

    function hasValidMedicationScheduleSchema(data) {
      return hasExactMedicationScheduleFields(data)
        && data.ownerUid is string
        && data.medicationId is string
        && data.medicationId.size() >= 1
        && data.medicationId.size() <= 150
        && data.medicationId.matches('^[^/]+$')
        && data.recurrence is string
        && data.recurrence in ['daily', 'weekly']
        && data.localTime is string
        && data.localTime.matches('^(?:[01][0-9]|2[0-3]):[0-5][0-9]$')
        && hasValidMedicationScheduleWeekdays(data.recurrence, data.weekdays)
        && hasValidMedicationScheduleDate(data.startDate)
        && (
          data.endDate == null
          || (hasValidMedicationScheduleDate(data.endDate) && data.endDate >= data.startDate)
        )
        && data.timeZone == 'Asia/Ho_Chi_Minh'
        && data.active is bool
        && data.revision is int
        && data.revision >= 1
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function hasActiveOwnedMedication(uid, medicationId) {
      return medicationId is string
        && exists(/databases/$(database)/documents/elderlyProfiles/$(uid)/medications/$(medicationId))
        && isActiveOwnedMedicationData(
          uid,
          get(/databases/$(database)/documents/elderlyProfiles/$(uid)/medications/$(medicationId)).data
        );
    }

    function isActiveOwnedMedicationData(uid, data) {
      return hasValidMedicationSchema(data)
        && data.ownerUid == uid
        && data.status == 'active';
    }

    function isValidMedicationScheduleCreate(uid) {
      return hasValidElderlyProfile(uid)
        && hasValidMedicationScheduleSchema(request.resource.data)
        && request.resource.data.ownerUid == uid
        && request.resource.data.active == true
        && request.resource.data.revision == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && hasActiveOwnedMedication(uid, request.resource.data.medicationId);
    }

    function isValidMedicationScheduleUpdate(uid) {
      return hasValidElderlyProfile(uid)
        && hasValidMedicationScheduleSchema(request.resource.data)
        && resource.data.ownerUid == uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.ownerUid == uid
        && request.resource.data.medicationId == resource.data.medicationId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'recurrence',
          'localTime',
          'weekdays',
          'startDate',
          'endDate',
          'active',
          'updatedAt',
          'revision'
        ])
        && (
          (resource.data.active == false && request.resource.data.active == false)
          || (
            resource.data.active == true
            && (
              request.resource.data.active == false
              || hasActiveOwnedMedication(uid, resource.data.medicationId)
            )
          )
        );
    }

    function hasExactDoseEventFields(data) {
      return data.keys().hasAll([
          'ownerUid',
          'scheduleId',
          'medicationId',
          'occurrenceKey',
          'scheduledAt',
          'scheduledLocalDate',
          'scheduledLocalTime',
          'timeZone',
          'medicationSnapshot',
          'status',
          'responseSource',
          'respondedAt',
          'respondedBy',
          'responseHistory',
          'revision',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid',
          'scheduleId',
          'medicationId',
          'occurrenceKey',
          'scheduledAt',
          'scheduledLocalDate',
          'scheduledLocalTime',
          'timeZone',
          'medicationSnapshot',
          'status',
          'responseSource',
          'respondedAt',
          'respondedBy',
          'responseHistory',
          'revision',
          'createdAt',
          'updatedAt'
        ]);
    }

    function hasValidDoseEventMedicationSnapshot(snapshot) {
      return snapshot is map
        && snapshot.keys().hasAll(['name', 'strengthText', 'directionsText'])
        && snapshot.keys().hasOnly(['name', 'strengthText', 'directionsText'])
        && snapshot.name is string
        && snapshot.name.size() >= 1
        && snapshot.name.size() <= 120
        && snapshot.name.matches('.*\\S.*')
        && snapshot.strengthText is string
        && snapshot.strengthText.size() <= 80
        && snapshot.directionsText is string
        && snapshot.directionsText.size() <= 500;
    }

    function hasValidDoseEventResponseHistory(history, uid, status) {
      return history is map
        && history.keys().hasAll(['initial'])
        && history.keys().hasOnly(['initial'])
        && history.initial is map
        && history.initial.keys().hasAll(['status', 'responseSource', 'respondedAt', 'respondedBy'])
        && history.initial.keys().hasOnly(['status', 'responseSource', 'respondedAt', 'respondedBy'])
        && history.initial.status == status
        && history.initial.responseSource == 'selfReported'
        && history.initial.respondedAt == request.time
        && history.initial.respondedBy == uid;
    }

    // Firestore stores timestamps in UTC. Viet Nam does not observe daylight
    // saving time, so adding seven hours lets Rules validate the exact HCM
    // calendar day and wall-clock time supplied by the client.
    function hasExactHcmDoseEventTimestamp(data) {
      let dateParts = data.scheduledLocalDate.split('-');
      let timeParts = data.scheduledLocalTime.split(':');
      let hcmScheduledAt = data.scheduledAt + duration.time(7, 0, 0, 0);
      let expectedHcmScheduledAt = timestamp.date(
        int(dateParts[0]),
        int(dateParts[1]),
        int(dateParts[2])
      ) + duration.time(int(timeParts[0]), int(timeParts[1]), 0, 0);
      return hcmScheduledAt == expectedHcmScheduledAt;
    }

    function hasValidDoseEventSchema(data, uid) {
      return hasExactDoseEventFields(data)
        && data.ownerUid is string
        && data.scheduleId is string
        && data.scheduleId.size() >= 1
        && data.scheduleId.size() <= 150
        && data.scheduleId.matches('^[^/]+$')
        && data.medicationId is string
        && data.medicationId.size() >= 1
        && data.medicationId.size() <= 150
        && data.medicationId.matches('^[^/]+$')
        && data.occurrenceKey is string
        && data.scheduledLocalDate is string
        && hasValidMedicationScheduleDate(data.scheduledLocalDate)
        && data.scheduledLocalTime is string
        && data.scheduledLocalTime.matches('^(?:[01][0-9]|2[0-3]):[0-5][0-9]$')
        && data.occurrenceKey == data.scheduledLocalDate + 'T' + data.scheduledLocalTime + '@Asia/Ho_Chi_Minh'
        && data.scheduledAt is timestamp
        && data.scheduledAt <= request.time
        && hasExactHcmDoseEventTimestamp(data)
        && data.timeZone == 'Asia/Ho_Chi_Minh'
        && hasValidDoseEventMedicationSnapshot(data.medicationSnapshot)
        && data.status is string
        && data.status in ['reportedTaken', 'reportedSkipped']
        && data.responseSource == 'selfReported'
        && data.respondedAt == request.time
        && data.respondedBy == uid
        && hasValidDoseEventResponseHistory(data.responseHistory, uid, data.status)
        && data.revision == 1
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function hasValidDoseEventScheduleReference(uid, data) {
      let schedulePath = /databases/$(database)/documents/elderlyProfiles/$(uid)/medicationSchedules/$(data.scheduleId);
      let schedule = get(schedulePath).data;
      let hcmScheduledAt = data.scheduledAt + duration.time(7, 0, 0, 0);
      return exists(schedulePath)
        && schedule.ownerUid == uid
        && schedule.active == true
        && schedule.medicationId == data.medicationId
        && schedule.localTime == data.scheduledLocalTime
        && schedule.timeZone == data.timeZone
        && schedule.recurrence is string
        && schedule.recurrence in ['daily', 'weekly']
        && schedule.weekdays is list
        && (
          schedule.recurrence == 'daily'
          || (
            schedule.recurrence == 'weekly'
            && schedule.weekdays.toSet().hasAll([hcmScheduledAt.dayOfWeek()])
          )
        )
        && schedule.startDate is string
        && data.scheduledLocalDate >= schedule.startDate
        && (
          schedule.endDate == null
          || (schedule.endDate is string && data.scheduledLocalDate <= schedule.endDate)
        );
    }

    function hasValidDoseEventMedicationReference(uid, data) {
      let medicationPath = /databases/$(database)/documents/elderlyProfiles/$(uid)/medications/$(data.medicationId);
      let medication = get(medicationPath).data;
      return exists(medicationPath)
        // M3.2 Rules enforce the exact persisted schema; only an active
        // same-owner medication can anchor a new self-report.
        && medication.ownerUid == uid
        && medication.status == 'active'
        && medication.name == data.medicationSnapshot.name
        && medication.strengthText == data.medicationSnapshot.strengthText
        && medication.directionsText == data.medicationSnapshot.directionsText;
    }

    function isValidDoseEventCreate(uid, doseEventId) {
      return hasValidElderlyProfile(uid)
        && hasValidDoseEventSchema(request.resource.data, uid)
        && request.resource.data.ownerUid == uid
        && doseEventId == request.resource.data.scheduleId
          + '__' + request.resource.data.scheduledLocalDate
          + '__' + request.resource.data.scheduledLocalTime
        && hasValidDoseEventScheduleReference(uid, request.resource.data)
        && hasValidDoseEventMedicationReference(uid, request.resource.data);
    }



    // Phase 03: many-to-many. One active connection per family/senior pair.
    function isFamily(uid) {
      let p = get(/databases/$(database)/documents/users/$(uid)).data;
      return p.uid == uid && hasValidUserProfileSchema(p)
        && p.primaryRole == 'caregiver' && p.onboardingCompleted == true;
    }
    function isSenior(uid) {
      let p = get(/databases/$(database)/documents/users/$(uid)).data;
      return p.uid == uid && hasValidUserProfileSchema(p)
        && p.primaryRole == 'elderly' && p.onboardingCompleted == true;
    }
    function validCode(code) {
      return code is string && code.matches('^[A-HJ-NP-Z2-9]{8}$');
    }
    function participant(d) {
      return signedIn() && (request.auth.uid == d.familyUid || request.auth.uid == d.seniorUid);
    }
    function freshInvite(d) {
      return d.status == 'active' && d.createdAt <= request.time
        && request.time < d.createdAt + duration.value(15, 'm');
    }
    function currentInvite(code, familyUid) {
      let s = get(/databases/$(database)/documents/connectionInviteSlots/$(familyUid)).data;
      return s.familyUid == familyUid && s.inviteCode == code && s.status == 'active';
    }
    function newInviteData(d, code) {
      return d.keys().hasOnly(['familyUid','familyDisplayName','status','createdAt','usedBy','usedAt','connectionId','updatedAt'])
        && validCode(code) && d.familyUid == request.auth.uid
        && d.familyDisplayName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
        && d.status == 'active' && d.createdAt == request.time && d.updatedAt == request.time
        && d.usedBy == null && d.usedAt == null && d.connectionId == null;
    }
    function newSlotData(d, uid) {
      let i = getAfter(/databases/$(database)/documents/connectionInvites/$(d.inviteCode)).data;
      return d.keys().hasOnly(['familyUid','inviteCode','status','createdAt','usedBy','usedAt','connectionId','updatedAt'])
        && d.familyUid == uid && validCode(d.inviteCode)
        && d.status == 'active' && d.createdAt == request.time && d.updatedAt == request.time
        && d.usedBy == null && d.usedAt == null && d.connectionId == null
        && i.familyUid == uid && i.status == 'active' && i.createdAt == request.time;
    }
    function createInvite(code) {
      let d = request.resource.data;
      let s = getAfter(/databases/$(database)/documents/connectionInviteSlots/$(request.auth.uid)).data;
      return signedIn() && isFamily(request.auth.uid) && newInviteData(d, code)
        && s.familyUid == request.auth.uid && s.inviteCode == code
        && s.status == 'active' && s.createdAt == request.time;
    }
    function rotateSlot(uid) {
      let d = request.resource.data;
      return signedIn() && request.auth.uid == uid && isFamily(uid)
        && resource.data.familyUid == uid && d.inviteCode != resource.data.inviteCode
        && newSlotData(d, uid)
        && (resource.data.status != 'active'
          || getAfter(/databases/$(database)/documents/connectionInvites/$(resource.data.inviteCode)).data.status == 'revoked');
    }
    function revokeInvite(code) {
      let s = getAfter(/databases/$(database)/documents/connectionInviteSlots/$(resource.data.familyUid)).data;
      return signedIn() && request.auth.uid == resource.data.familyUid && isFamily(request.auth.uid)
        && resource.data.status == 'active' && request.resource.data.status == 'revoked'
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
        && s.familyUid == request.auth.uid && s.inviteCode != code
        && s.status == 'active' && s.createdAt == request.time;
    }
    function consumeFields(d, code) {
      return d.status == 'used' && d.usedBy == request.auth.uid && d.usedAt == request.time
        && d.connectionId == code && d.updatedAt == request.time
        && d.diff(resource.data).affectedKeys().hasOnly(['status','usedBy','usedAt','connectionId','updatedAt']);
    }
    function newConnectionFor(code, familyUid) {
      let c = getAfter(/databases/$(database)/documents/connections/$(code)).data;
      return c.familyUid == familyUid && c.seniorUid == request.auth.uid
        && c.status == 'connected' && c.createdAt == request.time;
    }
    function useInvite(code) {
      let s = getAfter(/databases/$(database)/documents/connectionInviteSlots/$(resource.data.familyUid)).data;
      return signedIn() && isSenior(request.auth.uid) && freshInvite(resource.data)
        && currentInvite(code, resource.data.familyUid)
        && consumeFields(request.resource.data, code)
        && s.inviteCode == code && s.status == 'used' && s.usedBy == request.auth.uid
        && s.connectionId == code && s.usedAt == request.time
        && newConnectionFor(code, resource.data.familyUid);
    }
    function useSlot(uid) {
      let code = resource.data.inviteCode;
      let i = getAfter(/databases/$(database)/documents/connectionInvites/$(code)).data;
      return signedIn() && isSenior(request.auth.uid) && resource.data.familyUid == uid
        && resource.data.status == 'active' && consumeFields(request.resource.data, code)
        && i.familyUid == uid && i.status == 'used' && i.usedBy == request.auth.uid
        && i.connectionId == code && i.usedAt == request.time
        && newConnectionFor(code, uid);
    }
    function createConnection(code) {
      let d = request.resource.data;
      let i = getAfter(/databases/$(database)/documents/connectionInvites/$(code)).data;
      let p = getAfter(/databases/$(database)/documents/connectionPairs/$(d.familyUid)/seniors/$(d.seniorUid)).data;
      return signedIn() && validCode(code) && d.seniorUid == request.auth.uid
        && d.familyUid != d.seniorUid && isSenior(d.seniorUid) && isFamily(d.familyUid)
        && d.keys().hasOnly(['familyUid','seniorUid','familyDisplayName','seniorDisplayName','status','createdAt','connectedAt','disconnectedAt','disconnectedBy','updatedAt'])
        && d.familyDisplayName == get(/databases/$(database)/documents/users/$(d.familyUid)).data.displayName
        && d.seniorDisplayName == get(/databases/$(database)/documents/users/$(d.seniorUid)).data.displayName
        && d.status == 'connected' && d.createdAt == request.time && d.connectedAt == request.time
        && d.updatedAt == request.time && d.disconnectedAt == null && d.disconnectedBy == null
        && i.familyUid == d.familyUid && i.familyDisplayName == d.familyDisplayName
        && i.status == 'used' && i.usedBy == d.seniorUid
        && i.connectionId == code && i.usedAt == request.time
        && p.connectionId == code && p.status == 'connected' && p.updatedAt == request.time;
    }
    function activatePair(familyUid, seniorUid) {
      let d = request.resource.data;
      let c = /databases/$(database)/documents/connections/$(d.connectionId);
      let next = getAfter(c).data;
      return signedIn() && request.auth.uid == seniorUid && validCode(d.connectionId)
        && d.keys().hasOnly(['connectionId','status','updatedAt'])
        && d.status == 'connected' && d.updatedAt == request.time
        && !exists(c) && next.familyUid == familyUid && next.seniorUid == seniorUid
        && next.status == 'connected' && next.createdAt == request.time;
    }
    function disconnectConnection(code) {
      let d = resource.data;
      let p = getAfter(/databases/$(database)/documents/connectionPairs/$(d.familyUid)/seniors/$(d.seniorUid)).data;
      return participant(d) && d.status == 'connected'
        && request.resource.data.status == 'disconnected'
        && request.resource.data.disconnectedAt == request.time
        && request.resource.data.disconnectedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(d).affectedKeys().hasOnly(['status','disconnectedAt','disconnectedBy','updatedAt'])
        && p.connectionId == code && p.status == 'disconnected' && p.updatedAt == request.time;
    }
    function disconnectPair(familyUid, seniorUid) {
      let c = getAfter(/databases/$(database)/documents/connections/$(resource.data.connectionId)).data;
      return participant(c) && c.familyUid == familyUid && c.seniorUid == seniorUid
        && resource.data.status == 'connected' && request.resource.data.status == 'disconnected'
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
        && c.status == 'disconnected' && c.disconnectedBy == request.auth.uid
        && c.disconnectedAt == request.time;
    }

    // Migration 2.3 profile surface. `get` deliberately
    // excludes collection queries so users cannot enumerate other profiles.
    match /users/{uid} {
      allow get: if ownsUser(uid);
      allow list: if false;
      allow create: if isValidInitialUserProfile(uid);
      allow update: if isValidUserProfileUpdate(uid);
      allow delete: if false;

      // Device, notification, and index schemas are not part of M2.3 yet.
      match /{document=**} {
        allow read, write: if false;
      }
    }

    // A role selected by the client is not a health-data authorization grant.
    // These surfaces remain closed until their schema, server workflow, and
    // emulator coverage are approved in a later milestone.
    match /caregiverProfiles/{document=**} {
      allow read, write: if false;
    }

    match /caregiverInvites/{document=**} {
      allow read, write: if false;
    }



    match /connectionInvites/{code} {
      allow get: if signedIn() && ((resource.data.familyUid == request.auth.uid && isFamily(request.auth.uid))
        || (isSenior(request.auth.uid) && freshInvite(resource.data)
          && currentInvite(code, resource.data.familyUid)));
      allow list, delete: if false;
      allow create: if createInvite(code);
      allow update: if revokeInvite(code) || useInvite(code);
    }
    match /connectionInviteSlots/{uid} {
      allow get: if ownsUser(uid) && isFamily(uid);
      allow list, delete: if false;
      allow create: if ownsUser(uid) && isFamily(uid) && newSlotData(request.resource.data, uid);
      allow update: if rotateSlot(uid) || useSlot(uid);
    }
    match /connections/{code} {
      // List queries must constrain the caller's own familyUid or seniorUid.
      allow get, list: if participant(resource.data);
      allow create: if createConnection(code);
      allow update: if disconnectConnection(code);
      allow delete: if false;
    }
    match /connectionPairs/{familyUid}/seniors/{seniorUid} {
      allow get: if signedIn() && (request.auth.uid == familyUid || request.auth.uid == seniorUid);
      allow list, delete: if false;
      allow create: if activatePair(familyUid, seniorUid);
      allow update: if (resource.data.status == 'disconnected' && activatePair(familyUid, seniorUid))
        || disconnectPair(familyUid, seniorUid);
    }
    // The unshipped one-to-one index is not used or accessible.
    match /connectionMembers/{document=**} {
      allow read, write: if false;
    }

    // M3.2: an elderly owner may access only their own medication records.
    // A profile role from the UI never grants access; the canonical M2.3
    // `/users/{uid}` document is checked for every operation.
    match /elderlyProfiles/{uid}/medications/{medicationId} {
      allow get, list: if canAccessMedicationProfile(uid);
      allow create: if isValidMedicationCreate(uid);
      allow update: if isValidMedicationUpdate(uid);
      allow delete: if false;
    }

    // M3.3: schedules use the same elderly-owner boundary as medications.
    // They never grant notification, DoseEvent, or caregiver access.
    match /elderlyProfiles/{uid}/medicationSchedules/{scheduleId} {
      allow get, list: if hasValidElderlyProfile(uid);
      allow create: if isValidMedicationScheduleCreate(uid);
      allow update: if isValidMedicationScheduleUpdate(uid);
      allow delete: if false;
    }

    // M3.4: an elderly owner may create and read exactly one immutable
    // self-reported response for a real planned occurrence. Client updates,
    // deletes, notification documents, and caregiver access remain denied.
    match /elderlyProfiles/{uid}/doseEvents/{doseEventId} {
      allow get, list: if hasValidElderlyProfile(uid);
      allow create: if isValidDoseEventCreate(uid, doseEventId);
      allow update, delete: if false;
    }

    match /elderlyProfiles/{document=**} {
      allow read, write: if false;
    }

    // Explicit default-deny for every future collection and subcollection.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}